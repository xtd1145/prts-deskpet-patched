#!/bin/bash
# DSH choice postinstall (runs as root inside the pkg).
#
# The installer script is already staged at SHARE_DIR by the component package
# itself (pkgbuild --root .../root), so there is nothing to copy here — copying
# a file onto itself makes macOS `cp` exit non-zero ("are identical"), which
# with `set -e` used to abort the whole installation. This script therefore only
# makes the staged script executable and writes the opt-in marker; the actual
# download/setup runs at first app launch (as the user, with the right
# HOME/PATH), where it can register the LaunchAgent correctly.
set -e
SHARE_DIR="/usr/local/share/prts"
if [ -f "$SHARE_DIR/install-dsh.sh" ]; then
  chmod +x "$SHARE_DIR/install-dsh.sh"
fi
touch "$SHARE_DIR/.dsh-requested"
exit 0
